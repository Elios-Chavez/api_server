import { apiClient } from '@/services/api/client'; import { endpoints } from '@/services/api/endpoints'; import type { BusinessDataProvider, PurchaseInput, SaleInput } from './dataProvider'; import type { Feedback, InventoryAlert, InventoryRecord, Product, Promotion, PurchaseRecord, SaleRecord } from '@/types/domain';
export class ApiDataProvider implements BusinessDataProvider{getProducts(){return apiClient<Product[]>(endpoints.products)}getInventory(){return apiClient<InventoryRecord[]>(endpoints.inventory)}async updateInventory(id:string,patch:Partial<InventoryRecord>){return apiClient<InventoryRecord[]>(endpoints.inventory+'/'+id,{method:'PATCH',body:JSON.stringify(patch)})}getSales(){return apiClient<SaleRecord[]>(endpoints.sales)}registerSale(input:SaleInput){return apiClient<SaleRecord>(endpoints.sales,{method:'POST',body:JSON.stringify(input)})}getPurchases(){return apiClient<PurchaseRecord[]>(endpoints.purchases)}registerPurchase(input:PurchaseInput){return apiClient<PurchaseRecord>(endpoints.purchases,{method:'POST',body:JSON.stringify(input)})}getPromotions(){return apiClient<Promotion[]>(endpoints.promotions)}createPromotion(input:Omit<Promotion,'id'>){return apiClient<Promotion>(endpoints.promotions,{method:'POST',body:JSON.stringify(input)})}updatePromotion(id:string,input:Partial<Promotion>){return apiClient<Promotion>(endpoints.promotions+'/'+id,{method:'PATCH',body:JSON.stringify(input)})}getFeedback(){return apiClient<Feedback[]>(endpoints.feedback)}submitFeedback(input:Omit<Feedback,'id'>){return apiClient<Feedback>(endpoints.feedback,{method:'POST',body:JSON.stringify(input)})}getAlerts(){return apiClient<InventoryAlert[]>(endpoints.alerts)}getSummary(){return apiClient<Record<string,number>>(endpoints.summary)}}
