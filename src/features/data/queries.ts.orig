import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query'; import { getDataProvider } from './provider'; import type { Feedback, Promotion } from '@/types/domain'; import type { PurchaseInput, SaleInput } from './dataProvider';
export const queryKeys={products:['products'],inventory:['inventory'],sales:['sales'],purchases:['purchases'],promotions:['promotions'],feedback:['feedback'],alerts:['alerts'],summary:['summary'],demand:['demand'],copilotContext:['copilot-context']} as const;
export function useProductsQuery(){return useQuery({queryKey:queryKeys.products,queryFn:()=>getDataProvider().getProducts()})}
export function useInventoryQuery(){return useQuery({queryKey:queryKeys.inventory,queryFn:()=>getDataProvider().getInventory(),refetchInterval:4000})}
export function useSalesQuery(){return useQuery({queryKey:queryKeys.sales,queryFn:()=>getDataProvider().getSales()})}
export function usePurchasesQuery(){return useQuery({queryKey:queryKeys.purchases,queryFn:()=>getDataProvider().getPurchases()})}
export function usePromotionsQuery(){return useQuery({queryKey:queryKeys.promotions,queryFn:()=>getDataProvider().getPromotions()})}
export function useFeedbackQuery(){return useQuery({queryKey:queryKeys.feedback,queryFn:()=>getDataProvider().getFeedback(),refetchInterval:4000})}
export function useAlertsQuery(){return useQuery({queryKey:queryKeys.alerts,queryFn:()=>getDataProvider().getAlerts(),refetchInterval:4000})}
export function useSummaryQuery(){return useQuery({queryKey:queryKeys.summary,queryFn:()=>getDataProvider().getSummary()})}
const operationalKeys=[queryKeys.inventory,queryKeys.alerts,queryKeys.summary,queryKeys.copilotContext] as const;
export function useRegisterSaleMutation(){const client=useQueryClient();return useMutation({mutationFn:(input:SaleInput)=>getDataProvider().registerSale(input),onSuccess:async()=>{await Promise.all([...operationalKeys.map((queryKey)=>client.invalidateQueries({queryKey})),client.invalidateQueries({queryKey:queryKeys.sales})])}})}
export function useRegisterPurchaseMutation(){const client=useQueryClient();return useMutation({mutationFn:(input:PurchaseInput)=>getDataProvider().registerPurchase(input),onSuccess:async()=>{await Promise.all([...operationalKeys.map((queryKey)=>client.invalidateQueries({queryKey})),client.invalidateQueries({queryKey:queryKeys.purchases})])}})}
export function useUpdateInventoryMutation(){const client=useQueryClient();return useMutation({mutationFn:(input:{id:string;changes:Partial<import('@/types/domain').InventoryRecord>})=>getDataProvider().updateInventory(input.id,input.changes),onSuccess:async()=>{await Promise.all(operationalKeys.map((queryKey)=>client.invalidateQueries({queryKey})))}})}
export function useCreatePromotionMutation(){const client=useQueryClient();return useMutation({mutationFn:(input:Omit<Promotion,'id'>)=>getDataProvider().createPromotion(input),onSuccess:()=>client.invalidateQueries({queryKey:queryKeys.promotions})})}
export function useUpdatePromotionMutation(){const client=useQueryClient();return useMutation({mutationFn:(input:{id:string;changes:Partial<Promotion>})=>getDataProvider().updatePromotion(input.id,input.changes),onSuccess:()=>client.invalidateQueries({queryKey:queryKeys.promotions})})}
export function useSubmitFeedbackMutation(){const client=useQueryClient();return useMutation({mutationFn:(input:Omit<Feedback,'id'>)=>getDataProvider().submitFeedback(input),onSuccess:()=>client.invalidateQueries({queryKey:queryKeys.feedback})})}
